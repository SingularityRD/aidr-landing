# Public website settings. Copy to .env.local and fill in real values. Never commit real secrets.

# ── Site identity ────────────────────────────────────────────────────────────
# Canonical origin used for canonical URLs, sitemap.xml, robots.txt and security.txt.
NEXT_PUBLIC_SITE_URL=https://aidr.example.com

# ── Public contact mailboxes (leave unset until a monitored mailbox exists) ────
# When unset, pages link to the /contact form instead of showing an address.
NEXT_PUBLIC_CONTACT_SALES_EMAIL=
NEXT_PUBLIC_CONTACT_SUPPORT_EMAIL=
NEXT_PUBLIC_CONTACT_SECURITY_EMAIL=
NEXT_PUBLIC_CONTACT_PRIVACY_EMAIL=
NEXT_PUBLIC_CONTACT_LEGAL_EMAIL=

# ── Contact / sales form ─────────────────────────────────────────────────────
# HTTPS endpoint that receives each enquiry as JSON (a Slack-compatible incoming webhook, a
# ticketing intake or an automation URL). Without it the form reports "not connected"
# and nothing is sent. The URL is a secret: set it only in the hosting provider.
CONTACT_WEBHOOK_URL=

# Optional bot protection for the contact form (Cloudflare Turnstile). Set both or neither.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Optional diagnostics ─────────────────────────────────────────────────────
# Browser diagnostics only start after a visitor opts in; server diagnostics need a DSN.
NEXT_PUBLIC_SENTRY_DSN=

# ── Build identity shown by /api/health and /api/ready ───────────────────────
NEXT_PUBLIC_APP_VERSION=

# Clerk, Firebase, Polar and signing-secret variables are listed in README.md and DEPLOY.md.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY must be present at BUILD time: the Content-Security-Policy
# allows the Clerk frontend host decoded from it.
